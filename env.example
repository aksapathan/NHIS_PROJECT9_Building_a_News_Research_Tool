# Copy this file to ".env" and fill in your real values.
OPENAI_API_KEY=your-openai-api-key
NEWSAPI_KEY=your-newsapi-key

# Login (the app asks for these before showing anything)
AUTH_USERNAME=analyst
AUTH_PASSWORD=change-me
# Preferred instead of AUTH_PASSWORD: sha256 hex of your password, e.g.
#   python -c "import hashlib;print(hashlib.sha256(b'your-password').hexdigest())"
# AUTH_PASSWORD_SHA256=
# AUTH_DISABLED=true     # skip login (local experiments only)

# Optional
OPENAI_MODEL=gpt-4o-mini
# DB_PATH=news_tool.db
